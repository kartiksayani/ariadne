{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuePreviewRequest",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "#/$defs/SessionRef"
    },
    "source_topic_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "target": {
      "$ref": "#/$defs/SessionRef"
    }
  },
  "additionalProperties": false,
  "required": [
    "source",
    "source_topic_id",
    "target"
  ],
  "$defs": {
    "SessionRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id"
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
