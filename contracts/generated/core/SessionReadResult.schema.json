      "additionalProperties": false,
      "required": [
        "id",
        "seq",
        "binding_id",
        "kind",
        "target",
        "message_id",
        "answer_id",
        "created_at",
        "expected_question_revision",
        "payload",
        "state",
        "attempts",
        "active_attempt_id",
        "resolution_history"
      ]
    },
    "InputContext": {
      "type": "object",
      "properties": {
        "continuation_operation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        "message_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        },
        "round_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "message_ids",
        "item_ids",
        "round_id",
        "continuation_operation_id"
      ]
    },
    "InputKind": {
      "type": "string",
      "enum": [
        "answer",
        "bring",
        "reply",
        "note",
        "followup",
        "reopen",
        "drop",
        "continue"
      ]
    },
    "InputPayload": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/InputContext"
        },
        "intent": {
          "$ref": "#/$defs/InputKind"
        },
        "selected_option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_snapshot": {
          "$ref": "#/$defs/InputTargetSnapshot"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "intent",
        "target_snapshot",
        "selected_option_id",
        "context"
      ]
    },
    "InputQueueEntry": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "seq": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "state": {
          "$ref": "#/$defs/InputState"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "seq",
        "binding_id",
        "state"
      ]
    },
    "InputState": {
      "type": "string",
      "enum": [
        "queued",
        "in_flight",
        "handled",
        "cancelled",
        "needs_attention",
        "skipped"
      ]
    },
    "InputTarget": {
      "type": "object",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic_id",
        "item_id"
      ]
    },
    "InputTargetSnapshot": {
      "type": "object",
      "properties": {
        "ask": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemOption"
          }
        },
        "question_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic_name",
        "item_question",
        "question_revision",
        "ask",
        "options"
      ]
    },
    "ItemLinkTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemOrigin": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/ItemRef"
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "source_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id",
        "topic_id",
        "entity_id",
        "source_revision"
      ]
    },
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemReadProjection": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/ItemSnapshot"
