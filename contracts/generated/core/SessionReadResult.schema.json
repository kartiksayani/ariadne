        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "created_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "expected_question_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "message_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "payload": {
          "$ref": "#/$defs/InputPayload"
        },
        "resolution_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolutionHistoryEntry"
          }
