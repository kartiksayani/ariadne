            },
            "ordinals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PositiveSafeInteger"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "ordinals",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "round"
            },
            "ordinal": {
              "$ref": "#/$defs/PositiveSafeInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "ordinal",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "canonical_root": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "canonical_root",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "session"
            },
            "project_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "updated_at": {
              "$ref": "#/$defs/UtcMillis"
            }
          },
          "additionalProperties": false,
