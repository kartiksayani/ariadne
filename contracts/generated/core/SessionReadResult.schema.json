            }
          ]
        },
        "acceptance_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_generation": {
          "$ref": "#/$defs/UuidV4"
        },
        "claim_request_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "domain_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptError"
            },
            {
              "type": "null"
            }
          ]
        },
        "formatted_payload": {
          "type": "string"
        },
        "host_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "payload_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prepared_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "purpose": {
          "$ref": "#/$defs/AttemptPurpose"
        },
        "reconciliation_checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checkpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_for_attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_state": {
          "$ref": "#/$defs/ResultState"
        },
        "sealed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        },
        "wire_marker": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "repair_for_attempt_id",
        "claim_request_id",
        "binding_generation",
        "prepared_at",
        "formatted_payload",
        "payload_sha256",
        "wire_marker",
        "acceptance",
        "acceptance_receipt",
        "acceptance_observed_at",
        "host_turn_id",
        "turn_state",
        "turn_observed_at",
        "domain_result",
        "result_state",
        "sealed_at",
        "error",
        "reconciliation_checkpoint"
      ]
    },
    "AttemptError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "observed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "reason": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "retryable",
        "observed_at"
      ]
    },
    "AttemptPurpose": {
      "type": "string",
      "enum": [
        "work",
        "result_repair"
      ]
    },
    "Checkpoint": {
      "description": "At most 4096 UTF-8 bytes; maxLength only bounds Unicode characters.",
      "type": "string",
      "maxLength": 4096
    },
    "CursorPosition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
