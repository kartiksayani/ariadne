      "additionalProperties": false,
      "required": [
        "view",
        "page"
      ]
    },
    {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/Page_Message"
        },
        "view": {
          "type": "string",
          "const": "messages"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "page"
      ]
    },
    {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/Page_Input"
