            "kind": {
              "type": "string",
              "const": "history"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "attempt_ordinal": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "input_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "input_seq": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "kind": {
              "type": "string",
              "const": "result"
