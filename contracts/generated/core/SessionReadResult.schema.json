        "handled_through_message_number": {
          "$ref": "#/$defs/NonnegativeSafeInteger"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "outcome": {
          "$ref": "#/$defs/ResultOutcome"
        },
        "reply_message_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "outcome",
        "explanation",
        "reply_message_ids",
        "followup_item_ids",
        "handled_through_message_number",
        "committed_revision",
        "committed_at"
      ]
    },
    "HostReceipt": {
      "type": "object",
