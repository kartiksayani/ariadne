{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemPatch",
  "type": "object",
  "properties": {
    "links": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ItemLinkTarget"
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "related": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/EntityRef"
      }
    },
    "short": {
      "description": "Absent keeps the label, null clears it, a string replaces it (trimmed).",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemType"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "question",
    "type",
    "links"
  ],
  "$defs": {
    "EntityRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "ExistingRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ItemRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ItemLinkTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "question",
        "decision",
        "finding",
        "task",
        "explanation"
      ]
    },
    "LinkKind": {
      "type": "string",
      "enum": [
        "pr",
        "file",
        "doc",
        "item"
      ]
    },
    "LocalRef": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/RequestRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "ref"
      ]
    },
    "RequestRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}(?![\\s\\S])"
    }
  }
}
