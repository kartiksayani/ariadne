{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputQueueEntry",
  "type": "object",
  "properties": {
    "binding_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "id": {
      "$ref": "#/$defs/UuidV4"
    },
    "seq": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "state": {
      "$ref": "#/$defs/InputState"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "seq",
    "binding_id",
    "state"
  ],
  "$defs": {
    "InputState": {
      "type": "string",
      "enum": [
        "queued",
        "in_flight",
        "handled",
        "cancelled",
        "needs_attention",
        "skipped"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
