{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalRef",
  "type": "object",
  "properties": {
    "ref": {
      "$ref": "#/$defs/RequestRef"
    }
  },
  "additionalProperties": false,
  "required": [
    "ref"
  ],
  "$defs": {
    "RequestRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}(?![\\s\\S])"
    }
  }
}
