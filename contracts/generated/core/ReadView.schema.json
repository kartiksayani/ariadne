{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadView",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "archived": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "archived"
          ]
        },
        "view": {
          "type": "string",
          "const": "topics"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "filters"
      ]
    },
    {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "archived": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "item_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "parent_item_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "statuses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ItemStatus"
              }
            },
            "topic_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UuidV4"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "topic_id",
            "item_id",
            "parent_item_id",
            "statuses",
            "archived"
          ]
        },
        "view": {
          "type": "string",
          "const": "items"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "filters"
      ]
    },
    {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "item_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "topic_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UuidV4"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "topic_id",
            "item_id"
          ]
        },
        "view": {
          "type": "string",
          "const": "messages"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "filters"
      ]
    },
    {
      "type": "object",
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "item_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "states": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InputState"
              }
            },
            "topic_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UuidV4"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "topic_id",
            "item_id",
            "states"
          ]
        },
        "view": {
          "type": "string",
          "const": "inputs"
        }
      },
      "additionalProperties": false,
      "required": [
        "view",
        "filters"
      ]
    }
  ],
  "$defs": {
    "InputState": {
      "type": "string",
      "enum": [
        "queued",
        "in_flight",
        "handled",
        "cancelled",
        "needs_attention",
        "skipped"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
