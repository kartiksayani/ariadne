{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalPreferences",
  "type": "object",
  "properties": {
    "notification_watermark": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/WindowGeometry"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "theme",
    "window",
    "pinned",
    "notification_watermark"
  ],
  "$defs": {
    "Theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "WindowGeometry": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "monitor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "monitor_id"
      ]
    }
  }
}
