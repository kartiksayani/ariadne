{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalPreferences",
  "type": "object",
  "properties": {
    "detail_width": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 720,
      "minimum": 320
    },
    "notification_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NotificationEpisode"
      },
      "maxItems": 256
    },
    "notification_preview": {
      "type": "boolean"
    },
    "notification_watermark": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "selected_navigation": {
      "$ref": "#/$defs/NavigationSelection"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "waiting_collapsed": {
      "type": "boolean"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/WindowGeometry"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "theme",
    "selected_navigation",
    "window",
    "pinned",
    "notification_watermark"
  ],
  "$defs": {
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "NavigationSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "projects"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all_sessions"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            },
            "project_id": {
              "$ref": "#/$defs/UuidV4"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "project_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            },
            "session": {
              "$ref": "#/$defs/SessionRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "session"
          ]
        }
      ]
    },
    "NotificationEpisode": {
      "description": "Waiting episode identity is item + question revision within a registered session.",
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ItemRef"
        },
        "question_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "item_id",
        "question_revision"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id"
      ]
    },
    "Theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "WindowGeometry": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "monitor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "monitor_id"
      ]
    }
  }
}
