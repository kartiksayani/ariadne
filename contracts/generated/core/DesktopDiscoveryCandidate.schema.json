{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopDiscoveryCandidate",
  "type": "object",
  "properties": {
    "adapter_id": {
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "cwd": {
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/EndpointRef"
    },
    "external_session_id": {
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "host_version": {
      "type": "string"
    },
    "loaded": {
      "type": "boolean"
    },
    "observed_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "endpoint",
    "external_session_id",
    "cwd",
    "title",
    "host_version",
    "observed_at",
    "freshness",
    "compatibility",
    "availability",
    "loaded",
    "binding_id",
    "session"
  ],
  "$defs": {
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ]
    },
    "Compatibility": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        },
        {
          "description": "Same major.minor as the qualified baseline with a newer patch: accepted, not verified.",
          "type": "string",
          "const": "untested"
        }
      ]
    },
    "EndpointRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unix_socket"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_bridge"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "Freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "historical",
        "unknown"
      ]
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
