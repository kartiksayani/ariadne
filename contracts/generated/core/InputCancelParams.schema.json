{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputCancelParams",
  "type": "object",
  "properties": {
    "expected_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "input_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "purpose": {
      "anyOf": [
        {
          "$ref": "#/$defs/CancelPurpose"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "input_id",
    "expected_revision"
  ],
  "$defs": {
    "CancelPurpose": {
      "description": "What an owner `input_cancel` is for.",
      "oneOf": [
        {
          "description": "Delete the message: it is not sent.",
          "type": "string",
          "const": "delete"
        },
        {
          "description": "Take the message back to edit: only a message still queued can be.",
          "type": "string",
          "const": "edit"
        }
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
