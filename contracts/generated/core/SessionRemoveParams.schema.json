{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionRemoveParams",
  "description": "Uses `session: null` so an exact retry still replays after the file is gone.",
  "type": "object",
  "properties": {
    "expected_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "project_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "session_id": {
      "$ref": "#/$defs/UuidV4"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_id",
    "session_id",
    "expected_revision"
  ],
  "$defs": {
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
