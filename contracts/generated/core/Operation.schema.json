{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "topic.add"
        },
        "ref": {
          "$ref": "#/$defs/RequestRef"
        },
        "short": {
          "description": "Optional 2-4 word label; trimmed, one line, at most 40 characters, measured after trimming.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "ref",
        "name"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ask": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ItemLinkTarget"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "type": "string",
          "const": "item.add"
        },
        "options": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ItemOption"
          }
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "$ref": "#/$defs/ItemOwner"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RequestRef"
        },
        "related": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EntityRef"
          }
        },
        "replaced_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "short": {
          "description": "Optional 2-4 word label; trimmed, one line, at most 40 characters, measured after trimming.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "source_round_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "topic": {
          "$ref": "#/$defs/UuidRef"
        },
        "type": {
          "$ref": "#/$defs/ItemType"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "ref",
        "topic",
        "parent",
        "question",
        "type",
        "status",
        "owner",
        "ask",
        "options",
        "note",
        "links",
        "outcome",
        "why",
        "replaced_by",
        "source_round_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/EntityRef"
        },
        "op": {
          "type": "string",
          "const": "item.edit"
        },
        "patch": {
          "$ref": "#/$defs/ItemPatch"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "item",
        "patch"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/EntityRef"
        },
        "op": {
          "type": "string",
          "const": "item.ask"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemOption"
          }
        },
        "recipient_binding_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "item",
        "ask",
        "options",
        "recipient_binding_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/EntityRef"
        },
        "op": {
          "type": "string",
          "const": "item.status"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "item",
        "status",
        "outcome",
        "why",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/EntityRef"
        },
        "op": {
          "type": "string",
          "const": "item.replace"
        },
        "outcome": {
          "type": "string"
        },
        "replacement": {
          "$ref": "#/$defs/EntityRef"
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "item",
        "replacement",
        "outcome",
        "why"
      ]
    },
    {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/EntityRef"
        },
        "op": {
          "type": "string",
          "const": "reply"
        },
        "ref": {
          "$ref": "#/$defs/RequestRef"
        },
        "round_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "ref",
        "item",
        "text",
        "round_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "round.close"
        },
        "round_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "round_id"
      ]
    }
  ],
  "$defs": {
    "EntityRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "ExistingRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ItemRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ExistingUuidRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ItemLinkTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemPatch": {
      "type": "object",
      "properties": {
        "links": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ItemLinkTarget"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "related": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EntityRef"
          }
        },
        "short": {
          "description": "Absent keeps the label, null clears it, a string replaces it (trimmed).",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "question",
        "type",
        "links"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "question",
        "decision",
        "finding",
        "task",
        "explanation"
      ]
    },
    "LinkKind": {
      "type": "string",
      "enum": [
        "pr",
        "file",
        "doc",
        "item"
      ]
    },
    "LocalRef": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/RequestRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "ref"
      ]
    },
    "RequestRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}(?![\\s\\S])"
    },
    "UuidRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingUuidRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
