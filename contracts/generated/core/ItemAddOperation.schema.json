{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemAddOperation",
  "type": "object",
  "properties": {
    "ask": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ItemLinkTarget"
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ItemOption"
      }
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "$ref": "#/$defs/ItemOwner"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "type": "string"
    },
    "ref": {
      "$ref": "#/$defs/RequestRef"
    },
    "related": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/EntityRef"
      }
    },
    "replaced_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "short": {
      "description": "Optional 2-4 word label; trimmed, one line, at most 40 characters, measured after trimming.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "source_round_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "topic": {
      "$ref": "#/$defs/UuidRef"
    },
    "type": {
      "$ref": "#/$defs/ItemType"
    },
    "why": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "ref",
    "topic",
    "parent",
    "question",
    "type",
    "status",
    "owner",
    "ask",
    "options",
    "note",
    "links",
    "outcome",
    "why",
    "replaced_by",
    "source_round_id"
  ],
  "$defs": {
    "EntityRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "ExistingRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ItemRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ExistingUuidRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ItemLinkTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "question",
        "decision",
        "finding",
        "task",
        "explanation"
      ]
    },
    "LinkKind": {
      "type": "string",
      "enum": [
        "pr",
        "file",
        "doc",
        "item"
      ]
    },
    "LocalRef": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/RequestRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "ref"
      ]
    },
    "RequestRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}(?![\\s\\S])"
    },
    "UuidRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingUuidRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
