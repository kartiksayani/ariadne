        "params"
      ]
    },
    {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "command": {
          "type": "string",
          "const": "input_resolve"
        },
        "op_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "params": {
          "$ref": "#/$defs/InputResolveParams"
        }
      },
      "additionalProperties": false,
