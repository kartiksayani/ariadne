      ]
    }
  ],
  "$defs": {
    "AdapterConfig": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/UniqueMap"
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "values"
      ]
    },
    "BindingConnectParams": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "configuration": {
          "$ref": "#/$defs/AdapterConfig"
        },
        "endpoint": {
          "$ref": "#/$defs/EndpointRef"
        },
        "existing_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_session_id": {
          "type": "string"
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "adapter_id",
        "external_session_id",
        "endpoint",
        "configuration",
        "existing_session_id"
      ]
    },
    "BindingStateParams": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "expected_generation": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding_id",
        "expected_generation"
      ]
    },
    "EndpointRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unix_socket"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_bridge"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "GlobalPreferences": {
      "type": "object",
      "properties": {
        "notification_ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotificationEpisode"
          },
          "maxItems": 256
        },
        "notification_preview": {
          "type": "boolean"
        },
        "notification_watermark": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "selected_navigation": {
          "$ref": "#/$defs/NavigationSelection"
        },
        "theme": {
          "$ref": "#/$defs/Theme"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowGeometry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "theme",
        "selected_navigation",
        "window",
        "pinned",
        "notification_watermark"
      ]
    },
    "InputCancelParams": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "input_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "input_id",
        "expected_revision"
      ]
    },
    "InputKind": {
      "type": "string",
      "enum": [
        "answer",
        "bring",
        "reply",
        "note",
        "followup",
        "reopen",
        "drop",
        "continue"
      ]
    },
    "InputResolveParams": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "decision": {
          "$ref": "#/$defs/ResolutionKind"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/OwnerResolutionEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "input_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "input_id",
        "attempt_id",
        "decision",
        "reason",
        "expected_revision",
        "evidence"
      ]
    },
    "InputSubmitParams": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "expected_question_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "selected_option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_answer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/InputTarget"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding_id",
        "target",
        "kind",
        "text",
        "selected_option_id",
        "expected_question_revision",
        "supersedes_answer_id"
      ]
    },
    "InputTarget": {
      "type": "object",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic_id",
        "item_id"
      ]
    },
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemRoute": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ItemRef"
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id",
        "item_id"
      ]
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "NavigationSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "projects"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all_sessions"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            },
            "project_id": {
              "$ref": "#/$defs/UuidV4"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "project_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session"
            },
            "session": {
              "$ref": "#/$defs/SessionRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "session"
          ]
        }
      ]
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "NotificationEpisode": {
      "description": "Waiting episode identity is item + question revision within a registered session.",
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ItemRef"
        },
        "question_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "item_id",
        "question_revision"
      ]
    },
    "OwnerDraft": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "intent": {
          "$ref": "#/$defs/InputKind"
        },
        "op_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "question_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "submission_attempted": {
          "type": "boolean"
        },
        "supersedes_answer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/InputTarget"
        },
        "target_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op_id",
        "session",
        "binding_id",
        "target",
        "intent",
        "text",
        "selected_option_id",
        "target_revision",
        "question_revision",
        "supersedes_answer_id"
      ]
    },
    "OwnerEvidenceSource": {
      "type": "string",
      "enum": [
        "owner_attestation"
      ]
    },
    "OwnerResolutionEvidence": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "host_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_attested_idle": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/OwnerEvidenceSource"
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "turn_state",
        "host_turn_id",
        "owner_attested_idle",
        "at"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "PreferencesPatch": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferencesPatchEntry"
          }
        },
        "expected_preferences_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      },
      "additionalProperties": false,
      "required": [
        "expected_preferences_revision",
        "entries"
      ]
    },
    "PreferencesPatchEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_global"
            },
            "preferences": {
              "$ref": "#/$defs/GlobalPreferences"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preferences"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_session_view"
            },
            "preferences": {
              "$ref": "#/$defs/SessionPreferences"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preferences"
          ]
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "#/$defs/ItemRoute"
            },
            "kind": {
              "type": "string",
              "const": "set_later"
            },
            "later": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "item",
            "later"
          ]
        },
        {
          "type": "object",
          "properties": {
            "draft": {
              "$ref": "#/$defs/OwnerDraft"
            },
            "kind": {
              "type": "string",
              "const": "upsert_draft"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "draft"
          ]
        },
        {
