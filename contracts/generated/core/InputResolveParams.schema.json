{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputResolveParams",
  "type": "object",
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "decision": {
      "$ref": "#/$defs/ResolutionKind"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerResolutionEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "input_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "input_id",
    "attempt_id",
    "decision",
    "reason",
    "expected_revision",
    "evidence"
  ],
  "$defs": {
    "OwnerEvidenceSource": {
      "type": "string",
      "enum": [
        "owner_attestation"
      ]
    },
    "OwnerResolutionEvidence": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "host_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_attested_idle": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/OwnerEvidenceSource"
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "turn_state",
        "host_turn_id",
        "owner_attested_idle",
        "at"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "ResolutionKind": {
      "type": "string",
      "enum": [
        "retry_unexecuted",
        "resend",
        "skip",
        "request_result_repair",
        "confirm_evidence"
      ]
    },
    "TurnState": {
      "type": "string",
      "enum": [
        "unknown",
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
