{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationEnvelope_SavedReceipt",
  "anyOf": [
    {
      "$ref": "#/$defs/SuccessEnvelope_SavedReceipt"
    },
    {
      "$ref": "#/$defs/FailureEnvelope"
    }
  ],
  "$defs": {
    "AgentRemoval": {
      "description": "One recoverable removal, including owner questions and messages it took away.",
      "type": "object",
      "properties": {
        "cancelled_input_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        "message_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "waiting_questions": {
          "$ref": "#/$defs/NonnegativeSafeInteger"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic_id",
        "item_id",
        "message_id",
        "item_ids",
        "waiting_questions",
        "cancelled_input_ids"
      ]
    },
    "AllocatedRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "topic"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ItemRef"
            },
            "kind": {
              "type": "string",
              "const": "item"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "message"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "round"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "BarrierReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "owner_paused",
            "recovery_required",
            "disconnected",
            "lease_invalid",
            "incompatible",
            "result_missing",
            "delivery_uncertain",
            "host_failure",
            "store_error"
          ]
        },
        {
          "description": "The binding's session is closed; reopening it resumes dispatch.",
          "type": "string",
          "const": "session_closed"
        },
        {
          "description": "The binding exists in no registered session (removed or unknown).",
          "type": "string",
          "const": "session_removed"
        },
        {
          "description": "The owner cancelled or removed the input the agent names.",
          "type": "string",
          "const": "input_cancelled"
        },
        {
          "description": "The owner archived the topic an agent write targets; restore reopens it.",
          "type": "string",
          "const": "topic_archived"
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "deferred_delivery": {
          "$ref": "#/$defs/Capability"
        },
        "delivery_mode": {
          "$ref": "#/$defs/DeliveryMode"
        },
        "discover_sessions": {
          "$ref": "#/$defs/Capability"
        },
        "domain_cli": {
          "$ref": "#/$defs/Capability"
        },
        "domain_mcp": {
          "$ref": "#/$defs/Capability"
        },
        "existing_session": {
          "$ref": "#/$defs/Capability"
        },
        "final_text_read": {
          "$ref": "#/$defs/Capability"
        },
        "history_reconcile": {
          "$ref": "#/$defs/Capability"
        },
        "streaming_output": {
          "$ref": "#/$defs/Capability"
        },
        "turn_completion": {
          "$ref": "#/$defs/Capability"
        },
        "turn_correlation": {
          "$ref": "#/$defs/Capability"
        }
      },
      "additionalProperties": false,
      "required": [
        "existing_session",
        "deferred_delivery",
        "turn_correlation",
        "turn_completion",
        "domain_cli",
        "domain_mcp",
        "history_reconcile",
        "streaming_output",
        "final_text_read",
        "discover_sessions",
        "delivery_mode"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "supported",
        "conditions"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "reconnecting",
        "unknown"
      ]
    },
    "ContinuationReceipt": {
      "type": "object",
      "properties": {
        "answer_id_map": {
          "$ref": "#/$defs/UniqueMap6"
        },
        "confirmed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "item_id_map": {
          "$ref": "#/$defs/UniqueMap5"
        },
        "message_id_map": {
          "$ref": "#/$defs/UniqueMap6"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "round_id_map": {
          "$ref": "#/$defs/UniqueMap6"
        },
        "source_project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "source_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "source_session_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_topic_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "summary": {
          "type": "string"
        },
        "target_input_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "target_topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_project_id",
        "source_session_id",
        "source_topic_id",
        "source_revision",
        "source_sha256",
        "target_topic_id",
        "target_input_id",
        "item_id_map",
        "message_id_map",
        "round_id_map",
        "answer_id_map",
        "summary",
        "confirmed_at"
      ]
    },
    "CoreError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/CoreErrorCode"
        },
        "current_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetails"
            },
            {
              "type": "null"
            }
          ]
        },
        "field_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        },
        "hint": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "hint",
        "retryable",
        "field_errors"
      ]
    },
    "CoreErrorCode": {
      "type": "string",
      "enum": [
        "invalid_argument",
        "not_found",
        "binding_ambiguous",
        "binding_mismatch",
        "binding_conflict",
        "stale_generation",
        "incompatible_adapter",
        "host_unreachable",
        "revision_conflict",
        "question_changed",
        "unhandled_owner_message",
        "invalid_ref",
        "invalid_transition",
        "operation_reused",
        "result_already_committed",
        "attempt_sealed",
        "result_missing",
        "delivery_uncertain",
        "queue_full",
        "topic_not_archivable",
        "session_not_closable",
        "preview_stale",
        "snapshot_changed",
        "io_error",
        "store_busy",
        "capacity_exceeded",
        "commit_uncertain",
        "corrupt_session",
        "future_schema",
        "permission_denied",
        "unsupported",
        "protocol_conflict",
        "unsupported_host_version",
        "control_path_too_long"
      ]
    },
    "DeliveryMode": {
      "type": "string",
      "enum": [
        "pull",
        "push"
      ]
    },
    "DispatchState": {
      "type": "string",
      "enum": [
        "enabled",
        "paused",
        "recovery_required",
        "disconnected"
      ]
    },
    "ErrorDetails": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_input_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        },
        "blocking_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        "dispatch_must_pause": {
          "type": "boolean"
        },
        "input_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial_removal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialRemoval"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BarrierReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "binding_id",
        "input_id",
        "attempt_id",
        "blocking_item_ids",
        "blocking_input_ids",
        "dispatch_must_pause"
      ]
    },
    "FailureEnvelope": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "error": {
          "$ref": "#/$defs/CoreError"
        },
        "ok": {
          "$ref": "#/$defs/FailureFlag"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "ok",
        "error"
      ]
    },
    "FailureFlag": {
      "type": "boolean",
      "const": false
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ]
    },
    "InputState": {
      "type": "string",
      "enum": [
        "queued",
        "in_flight",
        "handled",
        "cancelled",
        "needs_attention",
        "skipped"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "MessageIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "number": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "number"
      ]
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "PartialRemoval": {
      "description": "The sessions a partial topic removal already left and still has to leave.",
      "type": "object",
      "properties": {
        "remaining": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "removed",
        "remaining"
      ]
    },
    "PauseReason": {
      "type": "string",
      "enum": [
        "result_missing",
        "uncertain",
        "host_failure",
        "store_error",
        "incompatible"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "RemovalTarget": {
      "description": "A session-qualified topic (family member) or notice input.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "id"
      ]
    },
    "ResolutionKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "retry_unexecuted",
            "resend",
            "skip",
            "request_result_repair",
            "confirm_evidence"
          ]
        },
        {
          "description": "The attempt already committed its result; the input is handled.",
          "type": "string",
          "const": "accept_result"
        }
      ]
    },
    "ResultState": {
      "type": "string",
      "enum": [
        "pending",
        "committed",
        "missing"
      ]
    },
    "SavedReceipt": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/SavedReceiptData"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "session_id",
        "revision",
        "data"
      ]
    },
    "SavedReceiptData": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answer_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UuidV4"
                },
                {
                  "type": "null"
                }
              ]
            },
            "input_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "input_seq": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "kind": {
              "type": "string",
              "const": "input_submit"
            },
            "message_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "message_number": {
              "$ref": "#/$defs/PositiveSafeInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input_id",
            "message_id",
            "message_number",
            "answer_id",
            "input_seq"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "input_cancel"
            },
            "state": {
              "$ref": "#/$defs/InputState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input_id",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "input_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "input_resolve"
            },
            "resolution_kind": {
              "$ref": "#/$defs/ResolutionKind"
            },
            "state": {
              "$ref": "#/$defs/InputState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input_id",
            "attempt_id",
            "resolution_kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "archived_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UtcMillis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cancelled_input_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UuidV4"
              }
            },
            "kind": {
              "type": "string",
              "const": "topic_lifecycle"
            },
            "topic_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "topic_revision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "topic_id",
            "topic_revision",
            "archived_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "archived_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UtcMillis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cancelled_input_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UuidV4"
              }
            },
            "closed_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UtcMillis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "session_lifecycle"
            },
            "state": {
              "$ref": "#/$defs/SessionState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state",
            "closed_at"
          ]
        },
        {
          "description": "Owner rename: the name and description now stored (`None` when cleared).",
          "type": "object",
          "properties": {
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "session_label"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "description"
          ]
        },
        {
          "type": "object",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemRef"
            },
            "item_revision": {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            "kind": {
              "type": "string",
              "const": "item_ack"
            },
            "message_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "status": {
              "$ref": "#/$defs/ItemStatus"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "item_id",
            "item_revision",
            "status",
            "message_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "capabilities": {
              "$ref": "#/$defs/Capabilities"
            },
            "generation": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "binding_connect"
            },
            "setup_instruction": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id",
            "generation",
            "capabilities",
            "setup_instruction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "connection_state": {
              "$ref": "#/$defs/ConnectionState"
            },
            "dispatch_state": {
              "$ref": "#/$defs/DispatchState"
            },
            "generation": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "binding_state"
            },
            "owner_paused": {
              "type": "boolean"
            },
            "pause_reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PauseReason"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id",
            "generation",
            "dispatch_state",
            "owner_paused",
            "pause_reason",
            "connection_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "item_id": {
              "anyOf": [
                {
