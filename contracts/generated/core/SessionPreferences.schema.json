{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionPreferences",
  "type": "object",
  "properties": {
    "expanded_item_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemRef"
      }
    },
    "filters": {
      "$ref": "#/$defs/ViewFilters"
    },
    "rail": {
      "$ref": "#/$defs/RailView"
    },
    "scroll": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScrollAnchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_item_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "$ref": "#/$defs/SessionRef"
    },
    "tab_order": {
      "$ref": "#/$defs/NonnegativeSafeInteger"
    }
  },
  "additionalProperties": false,
  "required": [
    "session",
    "selected_item_id",
    "tab_order",
    "expanded_item_ids",
    "filters",
    "rail",
    "scroll"
  ],
  "$defs": {
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "RailView": {
      "type": "string",
      "enum": [
        "waiting",
        "sent",
        "activity",
        "hidden"
      ]
    },
    "ScrollAnchor": {
      "type": "object",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "offset"
      ]
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id"
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "ViewFilters": {
      "type": "object",
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "hide_later": {
          "type": "boolean"
        },
        "search": {
          "type": "string"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStatus"
          }
        },
        "topic_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "search",
        "statuses",
        "topic_id",
        "archived",
        "hide_later"
      ]
    }
  }
}
