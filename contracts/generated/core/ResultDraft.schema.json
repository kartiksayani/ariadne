{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultDraft",
  "type": "object",
  "properties": {
    "explanation": {
      "type": "string"
    },
    "followup_item_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityRef"
      }
    },
    "handled_through_message_number": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "outcome": {
      "$ref": "#/$defs/ResultOutcome"
    },
    "reply_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UuidRef"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "outcome",
    "explanation",
    "reply_refs",
    "followup_item_refs",
    "handled_through_message_number"
  ],
  "$defs": {
    "EntityRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "ExistingRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ItemRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ExistingUuidRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "LocalRef": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/RequestRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "ref"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "RequestRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}(?![\\s\\S])"
    },
    "ResultOutcome": {
      "type": "string",
      "enum": [
        "answered",
        "deferred",
        "unable"
      ]
    },
    "UuidRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingUuidRef"
        },
        {
          "$ref": "#/$defs/LocalRef"
        }
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
