{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorDetails",
  "type": "object",
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocking_input_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UuidV4"
      }
    },
    "blocking_item_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemRef"
      }
    },
    "dispatch_must_pause": {
      "type": "boolean"
    },
    "input_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/BarrierReason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "reason",
    "binding_id",
    "input_id",
    "attempt_id",
    "blocking_item_ids",
    "blocking_input_ids",
    "dispatch_must_pause"
  ],
  "$defs": {
    "BarrierReason": {
      "type": "string",
      "enum": [
        "owner_paused",
        "recovery_required",
        "disconnected",
        "lease_invalid",
        "incompatible",
        "result_missing",
        "delivery_uncertain",
        "host_failure",
        "store_error"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
