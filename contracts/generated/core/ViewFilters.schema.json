{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewFilters",
  "type": "object",
  "properties": {
    "archived": {
      "type": "boolean"
    },
    "hide_later": {
      "type": "boolean"
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemOwner"
      }
    },
    "search": {
      "type": "string"
    },
    "statuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemStatus"
      }
    },
    "topic_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "search",
    "statuses",
    "owners",
    "topic_id",
    "archived",
    "hide_later"
  ],
  "$defs": {
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
