{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmitOutcome",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "accepted"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rejected_before_delivery"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "uncertain"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ]
    }
  ],
  "$defs": {
    "HostReceipt": {
      "type": "object",
      "properties": {
        "observed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "provider_reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_reference",
        "observed_at"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    }
  }
}
