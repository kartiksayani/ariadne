{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectResult",
  "type": "object",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "endpoint_fingerprint": {
      "type": "string"
    },
    "external_session_id": {
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/PresenceObservation"
    }
  },
  "additionalProperties": false,
  "required": [
    "external_session_id",
    "endpoint_fingerprint",
    "capabilities",
    "observation"
  ],
  "$defs": {
    "Capabilities": {
      "type": "object",
      "properties": {
        "deferred_delivery": {
          "$ref": "#/$defs/Capability"
        },
        "delivery_mode": {
          "$ref": "#/$defs/DeliveryMode"
        },
        "discover_sessions": {
          "$ref": "#/$defs/Capability"
        },
        "domain_cli": {
          "$ref": "#/$defs/Capability"
        },
        "domain_mcp": {
          "$ref": "#/$defs/Capability"
        },
        "existing_session": {
          "$ref": "#/$defs/Capability"
        },
        "final_text_read": {
          "$ref": "#/$defs/Capability"
        },
        "history_reconcile": {
          "$ref": "#/$defs/Capability"
        },
        "streaming_output": {
          "$ref": "#/$defs/Capability"
        },
        "turn_completion": {
          "$ref": "#/$defs/Capability"
        },
        "turn_correlation": {
          "$ref": "#/$defs/Capability"
        }
      },
      "additionalProperties": false,
      "required": [
        "existing_session",
        "deferred_delivery",
        "turn_correlation",
        "turn_completion",
        "domain_cli",
        "domain_mcp",
        "history_reconcile",
        "streaming_output",
        "final_text_read",
        "discover_sessions",
        "delivery_mode"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "supported",
        "conditions"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "reconnecting",
        "unknown"
      ]
    },
    "DeliveryMode": {
      "type": "string",
      "enum": [
        "pull",
        "push"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "waiting_for_approval",
        "unknown"
      ]
    },
    "Freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "historical",
        "unknown"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "PresenceObservation": {
      "type": "object",
      "properties": {
        "connection_state": {
          "$ref": "#/$defs/ConnectionState"
        },
        "execution_state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "generation": {
          "$ref": "#/$defs/UuidV4"
        },
        "instance_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresenceSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "instance_id",
        "generation",
        "connection_state",
        "execution_state",
        "last_seen_at",
        "source",
        "process_identity",
        "freshness"
      ]
    },
    "PresenceSource": {
      "type": "string",
      "enum": [
        "bridge_heartbeat",
        "host_poll",
        "host_event",
        "process_hint"
      ]
    },
    "ProcessIdentity": {
      "type": "object",
      "properties": {
        "pid": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "started_at": {
          "$ref": "#/$defs/UtcMillis"
        }
      },
      "additionalProperties": false,
      "required": [
        "pid",
        "started_at"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
