{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EndpointRef",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "unix_socket"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "local_bridge"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ]
    }
  ]
}
