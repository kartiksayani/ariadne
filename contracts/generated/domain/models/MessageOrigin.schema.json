{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageOrigin",
  "type": "object",
  "properties": {
    "adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "$ref": "#/$defs/MessageAuthor"
    },
    "binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "external_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "session_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "source_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "source_target": {
      "$ref": "#/$defs/MessageSourceTarget"
    },
    "topic_id": {
      "$ref": "#/$defs/UuidV4"
    }
  },
  "additionalProperties": false,
  "required": [
    "source_target",
    "project_id",
    "session_id",
    "topic_id",
    "entity_id",
    "source_revision",
    "author",
    "binding_id",
    "adapter_id",
    "external_session_id"
  ],
  "$defs": {
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "MessageAuthor": {
      "type": "string",
      "enum": [
        "owner",
        "agent",
        "system"
      ]
    },
    "MessageSourceTarget": {
      "description": "Historical direct route; these qualified IDs never provide local routing or authority.",
      "type": "object",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "round_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "topic_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id",
        "topic_id",
        "item_id",
        "round_id"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
