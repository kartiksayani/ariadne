{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageOrigin",
  "type": "object",
  "properties": {
    "adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "$ref": "#/$defs/MessageAuthor"
    },
    "binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "external_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "session_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "source_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "topic_id": {
      "$ref": "#/$defs/UuidV4"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_id",
    "session_id",
    "topic_id",
    "entity_id",
    "source_revision",
    "author",
    "binding_id",
    "adapter_id",
    "external_session_id"
  ],
  "$defs": {
    "MessageAuthor": {
      "type": "string",
      "enum": [
        "owner",
        "agent",
        "system"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
