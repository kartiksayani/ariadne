{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresenceObservation",
  "type": "object",
  "properties": {
    "connection_state": {
      "$ref": "#/$defs/ConnectionState"
    },
    "execution_state": {
      "$ref": "#/$defs/ExecutionState"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "generation": {
      "$ref": "#/$defs/UuidV4"
    },
    "instance_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "last_seen_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresenceSource"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "instance_id",
    "generation",
    "connection_state",
    "execution_state",
    "last_seen_at",
    "source",
    "process_identity",
    "freshness"
  ],
  "$defs": {
    "ConnectionState": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "reconnecting",
        "unknown"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "waiting_for_approval",
        "unknown"
      ]
    },
    "Freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "historical",
        "unknown"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "PresenceSource": {
      "type": "string",
      "enum": [
        "bridge_heartbeat",
        "host_poll",
        "host_event",
        "process_hint"
      ]
    },
    "ProcessIdentity": {
      "type": "object",
      "properties": {
        "pid": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "started_at": {
          "$ref": "#/$defs/UtcMillis"
        }
      },
      "additionalProperties": false,
      "required": [
        "pid",
        "started_at"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
