{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostReceipt",
  "type": "object",
  "properties": {
    "observed_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "provider_reference": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "provider_reference",
    "observed_at"
  ],
  "$defs": {
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    }
  }
}
