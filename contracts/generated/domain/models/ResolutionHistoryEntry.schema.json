{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolutionHistoryEntry",
  "type": "object",
  "properties": {
    "at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "attempt_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerResolutionEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/ResolutionKind"
    },
    "op_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "op_id",
    "kind",
    "reason",
    "at",
    "attempt_id",
    "evidence"
  ],
  "$defs": {
    "OwnerEvidenceSource": {
      "type": "string",
      "enum": [
        "owner_attestation"
      ]
    },
    "OwnerResolutionEvidence": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "host_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_attested_idle": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/OwnerEvidenceSource"
        },
        "turn_state": {
          "$ref": "#/$defs/TurnState"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "turn_state",
        "host_turn_id",
        "owner_attested_idle",
        "at"
      ]
    },
    "ResolutionKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "retry_unexecuted",
            "resend",
            "skip",
            "request_result_repair",
            "confirm_evidence"
          ]
        },
        {
          "description": "The attempt already committed its result; the input is handled.",
          "type": "string",
          "const": "accept_result"
        }
      ]
    },
    "TurnState": {
      "type": "string",
      "enum": [
        "unknown",
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
