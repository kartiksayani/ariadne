{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoundSnapshot",
  "description": "Frozen round fields; each historical list has an independent page below.",
  "type": "object",
  "properties": {
    "ask_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "closed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/UuidV4"
    },
    "item_id": {
      "$ref": "#/$defs/ItemRef"
    },
    "opened_message_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "options_snapshot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemOption"
      }
    },
    "ordinal": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoundOrigin"
        },
        {
          "type": "null"
        }
      ]
    },
    "question_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "question_snapshot": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "item_id",
    "ordinal",
    "opened_message_id",
    "question_snapshot",
    "ask_snapshot",
    "options_snapshot",
    "question_revision",
    "closed_at",
    "origin"
  ],
  "$defs": {
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "RoundOrigin": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "source_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id",
        "topic_id",
        "entity_id",
        "source_revision"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
