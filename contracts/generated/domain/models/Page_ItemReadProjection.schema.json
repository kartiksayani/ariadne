    },
    "SchemaVersion": {
      "type": "integer",
      "maximum": 1,
      "minimum": 1
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "StatusHistoryEntry": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/UtcMillis"
