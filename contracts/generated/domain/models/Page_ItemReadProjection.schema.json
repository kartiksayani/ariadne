    "QueryCursor": {
      "type": "object",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CursorPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "filter_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "schema": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "view": {
          "$ref": "#/$defs/QueryView"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "view",
        "filter_digest",
        "after",
        "revision"
      ]
    },
    "QueryView": {
      "type": "string",
      "enum": [
        "projects",
        "sessions",
        "topics",
        "items",
        "messages",
        "inputs",
        "item_messages",
        "item_rounds",
        "round_answers",
        "round_owner_messages",
        "round_agent_messages",
        "round_results",
        "round_forks",
        "item_status_history",
        "item_updated_messages"
