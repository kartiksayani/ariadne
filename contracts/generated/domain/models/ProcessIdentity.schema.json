{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessIdentity",
  "type": "object",
  "properties": {
    "pid": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "started_at": {
      "$ref": "#/$defs/UtcMillis"
    }
  },
  "additionalProperties": false,
  "required": [
    "pid",
    "started_at"
  ],
  "$defs": {
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    }
  }
}
