{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemSnapshot",
  "description": "All current item fields except unbounded updated-message and status-history arrays.",
  "type": "object",
  "properties": {
    "ask": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "created_message_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "current_round_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/ItemRef"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemLinkTarget"
      }
    },
    "next_child": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemOption"
      }
    },
    "ordinal": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemOrigin"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "$ref": "#/$defs/ItemOwner"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "type": "string"
    },
    "question_revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "recipient_binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "related": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ItemRef"
      }
    },
    "replaced_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "short": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_round_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "topic_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "type": {
      "$ref": "#/$defs/ItemType"
    },
    "updated_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "waiting_since": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "why": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "ordinal",
    "topic_id",
    "parent",
    "question",
    "type",
    "status",
    "owner",
    "revision",
    "question_revision",
    "next_child",
    "ask",
    "note",
    "options",
    "links",
    "outcome",
    "why",
    "replaced_by",
    "created_at",
    "updated_at",
    "created_message_id",
    "waiting_since",
    "recipient_binding_id",
    "current_round_id",
    "source_round_id",
    "origin"
  ],
  "$defs": {
    "ItemLinkTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "target"
      ]
    },
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemOrigin": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/ItemRef"
        },
        "project_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "session_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "source_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "topic_id": {
          "$ref": "#/$defs/UuidV4"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_id",
        "session_id",
        "topic_id",
        "entity_id",
        "source_revision"
      ]
    },
    "ItemOwner": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "me"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding_id": {
              "$ref": "#/$defs/UuidV4"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "ItemType": {
      "type": "string",
      "enum": [
        "question",
        "decision",
        "finding",
        "task",
        "explanation"
      ]
    },
    "LinkKind": {
      "type": "string",
      "enum": [
        "pr",
        "file",
        "doc",
        "item"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
