{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputKind",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "answer",
        "bring",
        "reply",
        "note",
        "followup",
        "reopen",
        "drop",
        "continue"
      ]
    },
    {
      "description": "The owner removed items or topics; the agent stops work on them.",
      "type": "string",
      "const": "removed"
    },
    {
      "description": "The owner's instruction for a whole topic (target has no item).",
      "type": "string",
      "const": "topic_reply"
    }
  ]
}
