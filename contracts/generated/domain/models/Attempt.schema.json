{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attempt",
  "type": "object",
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/AcceptanceState"
    },
    "acceptance_observed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_generation": {
      "$ref": "#/$defs/UuidV4"
    },
    "claim_request_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "domain_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/DomainResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptError"
        },
        {
          "type": "null"
        }
      ]
    },
    "formatted_payload": {
      "type": "string"
    },
    "host_turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "$ref": "#/$defs/UuidV4"
    },
    "payload_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "prepared_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "purpose": {
      "$ref": "#/$defs/AttemptPurpose"
    },
    "reconciliation_checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_for_attempt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_state": {
      "$ref": "#/$defs/ResultState"
    },
    "sealed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn_observed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn_state": {
      "$ref": "#/$defs/TurnState"
    },
    "wire_marker": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "purpose",
    "repair_for_attempt_id",
    "claim_request_id",
    "binding_generation",
    "prepared_at",
    "formatted_payload",
    "payload_sha256",
    "wire_marker",
    "acceptance",
    "acceptance_receipt",
    "acceptance_observed_at",
    "host_turn_id",
    "turn_state",
    "turn_observed_at",
    "domain_result",
    "result_state",
    "sealed_at",
    "error",
    "reconciliation_checkpoint"
  ],
  "$defs": {
    "AcceptanceState": {
      "type": "string",
      "enum": [
        "prepared",
        "accepted",
        "rejected",
        "uncertain"
      ]
    },
    "AttemptError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "observed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "reason": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "retryable",
        "observed_at"
      ]
    },
    "AttemptPurpose": {
      "type": "string",
      "enum": [
        "work",
        "result_repair"
      ]
    },
    "Checkpoint": {
      "description": "At most 4096 UTF-8 bytes; maxLength only bounds Unicode characters.",
      "type": "string",
      "maxLength": 4096
    },
    "DomainResult": {
      "type": "object",
      "properties": {
        "committed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "committed_revision": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "explanation": {
          "type": "string"
        },
        "followup_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        "handled_through_message_number": {
          "$ref": "#/$defs/NonnegativeSafeInteger"
        },
        "operation_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "outcome": {
          "$ref": "#/$defs/ResultOutcome"
        },
        "reply_message_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "outcome",
        "explanation",
        "reply_message_ids",
        "followup_item_ids",
        "handled_through_message_number",
        "committed_revision",
        "committed_at"
      ]
    },
    "HostReceipt": {
      "type": "object",
      "properties": {
        "observed_at": {
          "$ref": "#/$defs/UtcMillis"
        },
        "provider_reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_reference",
        "observed_at"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "ResultOutcome": {
      "type": "string",
      "enum": [
        "answered",
        "deferred",
        "unable"
      ]
    },
    "ResultState": {
      "type": "string",
      "enum": [
        "pending",
        "committed",
        "missing"
      ]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "TurnState": {
      "type": "string",
      "enum": [
        "unknown",
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
