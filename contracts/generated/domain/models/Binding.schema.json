{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Binding",
  "type": "object",
  "properties": {
    "active_input_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter_config": {
      "$ref": "#/$defs/AdapterConfig"
    },
    "adapter_id": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "config_version": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "connection_state": {
      "$ref": "#/$defs/ConnectionState"
    },
    "created_at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "dispatch_state": {
      "$ref": "#/$defs/DispatchState"
    },
    "endpoint": {
      "$ref": "#/$defs/EndpointRef"
    },
    "endpoint_fingerprint": {
      "type": "string"
    },
    "external_session_id": {
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/UuidV4"
    },
    "host_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "$ref": "#/$defs/UuidV4"
    },
    "issued_through_message_number": {
      "$ref": "#/$defs/NonnegativeSafeInteger"
    },
    "owner_paused": {
      "type": "boolean"
    },
    "pause_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/PauseReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_major": {
      "$ref": "#/$defs/PositiveSafeInteger"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "adapter_id",
    "adapter_version",
    "protocol_major",
    "config_version",
    "external_session_id",
    "endpoint",
    "endpoint_fingerprint",
    "generation",
    "created_at",
    "dispatch_state",
    "owner_paused",
    "pause_reason",
    "connection_state",
    "capabilities",
    "active_input_id",
    "issued_through_message_number",
    "adapter_config"
  ],
  "$defs": {
    "AdapterConfig": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/UniqueMap"
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "values"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "deferred_delivery": {
          "$ref": "#/$defs/Capability"
        },
        "delivery_mode": {
          "$ref": "#/$defs/DeliveryMode"
        },
        "discover_sessions": {
          "$ref": "#/$defs/Capability"
        },
        "domain_cli": {
          "$ref": "#/$defs/Capability"
        },
        "domain_mcp": {
          "$ref": "#/$defs/Capability"
        },
        "existing_session": {
          "$ref": "#/$defs/Capability"
        },
        "final_text_read": {
          "$ref": "#/$defs/Capability"
        },
        "history_reconcile": {
          "$ref": "#/$defs/Capability"
        },
        "streaming_output": {
          "$ref": "#/$defs/Capability"
        },
        "turn_completion": {
          "$ref": "#/$defs/Capability"
        },
        "turn_correlation": {
          "$ref": "#/$defs/Capability"
        }
      },
      "additionalProperties": false,
      "required": [
        "existing_session",
        "deferred_delivery",
        "turn_correlation",
        "turn_completion",
        "domain_cli",
        "domain_mcp",
        "history_reconcile",
        "streaming_output",
        "final_text_read",
        "discover_sessions",
        "delivery_mode"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "supported",
        "conditions"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "reconnecting",
        "unknown"
      ]
    },
    "DeliveryMode": {
      "type": "string",
      "enum": [
        "pull",
        "push"
      ]
    },
    "DispatchState": {
      "type": "string",
      "enum": [
        "enabled",
        "paused",
        "recovery_required",
        "disconnected"
      ]
    },
    "EndpointRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unix_socket"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_bridge"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "PauseReason": {
      "type": "string",
      "enum": [
        "result_missing",
        "uncertain",
        "host_failure",
        "store_error",
        "incompatible"
      ]
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "UniqueMap": {
      "description": "Deterministically serialized map that rejects duplicate keys on read.",
      "type": "object",
      "additionalProperties": true
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
