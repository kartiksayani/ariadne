{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRemovalSource",
  "description": "The agent and activity message that put work in the recoverable bin.",
  "type": "object",
  "properties": {
    "binding_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "message_id": {
      "$ref": "#/$defs/UuidV4"
    }
  },
  "additionalProperties": false,
  "required": [
    "binding_id",
    "message_id"
  ],
  "$defs": {
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
