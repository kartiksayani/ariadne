{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusHistoryEntry",
  "type": "object",
  "properties": {
    "at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/UuidV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "cause_message_id": {
      "$ref": "#/$defs/UuidV4"
    },
    "handled_through_message_number": {
      "$ref": "#/$defs/NonnegativeSafeInteger"
    },
    "new_status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "old_status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "previous_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_replaced_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_why": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "old_status",
    "new_status",
    "previous_outcome",
    "previous_why",
    "previous_replaced_by",
    "cause_message_id",
    "at",
    "binding_id",
    "handled_through_message_number",
    "reason"
  ],
  "$defs": {
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_me",
        "in_progress",
        "decided",
        "done",
        "dropped",
        "replaced"
      ]
    },
    "NonnegativeSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
