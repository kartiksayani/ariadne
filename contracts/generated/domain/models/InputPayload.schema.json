{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputPayload",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/InputContext"
    },
    "intent": {
      "$ref": "#/$defs/InputKind"
    },
    "removed": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemovedNotice"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_option_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_snapshot": {
      "$ref": "#/$defs/InputTargetSnapshot"
    },
    "text": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "text",
    "intent",
    "target_snapshot",
    "selected_option_id",
    "context"
  ],
  "$defs": {
    "InputContext": {
      "type": "object",
      "properties": {
        "continuation_operation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemRef"
          }
        },
        "message_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UuidV4"
          }
        },
        "round_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UuidV4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "message_ids",
        "item_ids",
        "round_id",
        "continuation_operation_id"
      ]
    },
    "InputKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "answer",
            "bring",
            "reply",
            "note",
            "followup",
            "reopen",
            "drop",
            "continue"
          ]
        },
        {
          "description": "The owner removed items or topics; the agent stops work on them.",
          "type": "string",
          "const": "removed"
        }
      ]
    },
    "InputTargetSnapshot": {
      "type": "object",
      "properties": {
        "ask": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemOption"
          }
        },
        "question_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveSafeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "topic_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic_name",
        "item_question",
        "question_revision",
        "ask",
        "options"
      ]
    },
    "ItemOption": {
      "type": "object",
      "properties": {
        "consequence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ]
    },
    "ItemRef": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991)(?:\\.(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990[0-9]{0}|9007199254740991))*(?![\\s\\S])"
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "RemovedNotice": {
      "description": "The owner's removal notice. Removed refs no longer exist in Ariadne.",
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemovedRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "refs",
        "note"
      ]
    },
    "RemovedRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "item"
            },
            "question": {
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/ItemRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "ref",
            "question"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "topic"
            },
            "name": {
              "type": "string"
            },
            "topic_id": {
              "$ref": "#/$defs/UuidV4"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "topic_id",
            "name"
          ]
        }
      ]
    },
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
