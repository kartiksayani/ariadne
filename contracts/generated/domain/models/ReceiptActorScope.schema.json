{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReceiptActorScope",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "owner"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "kind": {
          "type": "string",
          "const": "agent"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "binding_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/UuidV4"
        },
        "kind": {
          "type": "string",
          "const": "adapter"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "binding_id"
      ]
    }
  ],
  "$defs": {
    "UuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    }
  }
}
