{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnerResolutionEvidence",
  "type": "object",
  "properties": {
    "at": {
      "$ref": "#/$defs/UtcMillis"
    },
    "host_turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_attested_idle": {
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/OwnerEvidenceSource"
    },
    "turn_state": {
      "$ref": "#/$defs/TurnState"
    }
  },
  "additionalProperties": false,
  "required": [
    "source",
    "turn_state",
    "host_turn_id",
    "owner_attested_idle",
    "at"
  ],
  "$defs": {
    "OwnerEvidenceSource": {
      "type": "string",
      "enum": [
        "owner_attestation"
      ]
    },
    "TurnState": {
      "type": "string",
      "enum": [
        "unknown",
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "UtcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"
    }
  }
}
